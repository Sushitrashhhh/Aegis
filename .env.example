# ==============================================================================
# FREE TIER OPTIONS (Pick any ONE or use the Built-in Zero-Key Mode)
# ==============================================================================

# OPTION A: 100% Free Groq Cloud (Llama 3.3 70B & Llama 3.1 8B - Fast & Free)
# Get free key (No credit card needed) at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION B: 100% Free Google Gemini (Gemini 1.5 Flash / 2.0 Flash)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OPTION C: AWS Bedrock (Claude 3 Haiku / Claude 3 Sonnet / Titan Embeddings)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# OPTION D: Built-in Offline Simulation Engine ($0 / Zero API Keys Required)
# If all keys above are left blank, Cyra Sentinel runs automatically offline!

# ==============================================================================
# OPTIONAL SERVICES & DATABASE
# ==============================================================================

# AWS S3 Storage (Optional - for incident evidence & forensic telemetry logs)
S3_BUCKET_NAME=

# Database Configuration (CockroachDB / PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./cyra_sentinel.db

# Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
